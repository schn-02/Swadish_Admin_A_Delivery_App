<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:shimmer="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearViewPager"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="10dp"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:weightSum="2">

    <!-- Shimmer Card 1 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        app:cardBackgroundColor="#121212"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeColor="#18FFFFFF"
        app:strokeWidth="1dp">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/simmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:shimmer_auto_start="true"
            app:shimmer_duration="1200">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Image Placeholder -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="@drawable/bg_shimmer_rounded" />

                <!-- Product Name Placeholder -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_shimmer_rounded" />

                <View
                    android:layout_width="70dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_shimmer_rounded" />

                <!-- Unit Placeholder -->
                <View
                    android:layout_width="55dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_shimmer_rounded" />

                <!-- Price + Badge Placeholder -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="58dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_shimmer_rounded" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_shimmer_pill" />

                </LinearLayout>

            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Shimmer Card 2 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        app:cardBackgroundColor="#121212"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeColor="#18FFFFFF"
        app:strokeWidth="1dp">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/simmer2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:shimmer_auto_start="true"
            app:shimmer_duration="1200">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Image Placeholder -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="@drawable/bg_shimmer_rounded" />

                <!-- Product Name Placeholder -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_shimmer_rounded" />

                <View
                    android:layout_width="70dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_shimmer_rounded" />

                <!-- Unit Placeholder -->
                <View
                    android:layout_width="55dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_shimmer_rounded" />

                <!-- Price + Badge Placeholder -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="58dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_shimmer_rounded" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_shimmer_pill" />

                </LinearLayout>

            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>