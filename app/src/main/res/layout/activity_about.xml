<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/aboutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aa2"
    tools:context=".AboutActivity">

    <!-- Dark Overlay -->
    <View
        android:id="@+id/darkOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#B802040A"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Soft Glow -->
    <View
        android:id="@+id/topGlow"
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:layout_marginTop="-90dp"
        android:layout_marginEnd="-90dp"
        android:alpha="0.45"
        android:background="@drawable/bg_soft_glow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/aboutScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Brand Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/aboutCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="28dp"
                app:cardElevation="14dp"
                app:strokeColor="#22FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_section_card_dark"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="22dp">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/loadingFood7"
                        android:layout_width="match_parent"
                        android:layout_height="155dp"
                        android:contentDescription="Food Ordering App Animation"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/aboutanimation" />

                    <TextView
                        android:id="@+id/aboutTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-black"
                        android:text="Swadish Admin Panel"
                        android:textAlignment="center"
                        android:textColor="@android:color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/aboutSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_auth_tag"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Food Ordering Management App"
                        android:textColor="#44F28C"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="70dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_about_divider_premium" />

                    <TextView
                        android:id="@+id/aboutDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:lineSpacingExtra="5dp"
                        android:text="Swadish is an admin-side food ordering management application designed to manage food items, orders, and essential app operations through a clean and reliable interface."
                        android:textAlignment="center"
                        android:textColor="#DDE6FF"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Features Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/featuresCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="10dp"
                app:strokeColor="#22FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_about_feature_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Key Highlights"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/featuresText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="6dp"
                        android:text="• Clean admin interface\n• Easy food and order management\n• Smooth navigation\n• Focused on usability and reliability"
                        android:textColor="#C9D4F2"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Developer / Contact Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/contactCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="10dp"
                app:strokeColor="#22FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_about_feature_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/builtByText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Developed by Sachin Rawat"
                        android:textAlignment="center"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/stayInTouch"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_small_chip"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Contact Us"
                        android:textColor="#9AA7C7"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/socialContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/instagram"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="18dp"
                            android:background="@drawable/bg_social_icon_premium"
                            android:contentDescription="Instagram"
                            android:padding="8dp"
                            android:src="@drawable/instagram" />

                        <ImageView
                            android:id="@+id/gmail"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="18dp"
                            android:background="@drawable/bg_social_icon_premium"
                            android:contentDescription="Gmail"
                            android:padding="8dp"
                            android:src="@drawable/gmail" />

                        <ImageView
                            android:id="@+id/linkedin"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_social_icon_premium"
                            android:contentDescription="LinkedIn"
                            android:padding="8dp"
                            android:src="@drawable/linkedin" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>