<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#3A1B1B" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#66FF6B6B" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#241C27" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#33FF6B6B" />
        </shape>
    </item>

</selector>